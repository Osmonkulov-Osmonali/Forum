// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

// ─────────────────────────────────────────
// Models
// ─────────────────────────────────────────

/// Newsletter / waiting-list subscriber
model Subscriber {
  id        String           @id @default(cuid())
  email     String           @unique
  status    SubscriberStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  @@index([email])
  @@index([status])
  @@map("subscribers")
}

/// Event registration
model Registration {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String?           // optional — stored as NULL when not provided
  phone      String
  format     String            // "Offline" | "Online"
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("registrations")
}

/// Forum speaker
model Speaker {
  id          String   @id @default(cuid())
  name        String
  position    String
  company     String?
  description String   @db.Text
  imageUrl    String
  country     String?
  continent   String?           // "na" | "europe" | "asia" | "other"
  featured    Boolean  @default(false)
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, sortOrder])
  @@map("speakers")
}
