# Copy this file to .env and fill in your values

# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────

# Pooled connection (Prisma Client — runtime queries)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection (Prisma Migrate / db push)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Vercel Blob ──────────────────────────────────────────────────────────────
# Get from: Vercel Dashboard → Storage → Blob → your store → .env.local snippet
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# ─── Admin panel ─────────────────────────────────────────────────────────────
# Статический пароль для доступа к /admin
ADMIN_PASSWORD="your-secret-admin-password"
