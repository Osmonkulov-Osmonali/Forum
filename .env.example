# Copy this file to .env and fill in your values from Neon dashboard

# Pooled connection (Prisma Client — runtime queries)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection (Prisma Migrate — migrations)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
